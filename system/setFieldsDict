FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue T 0
);

regions
(
    boxToCell
    { //z coordinate goes from -0.0005 to 0.0005
        box (-107 32 0) (215 59 0.8);
        fieldValues
        (
            volScalarFieldValue T 1
        );
    }
);

